msgid "plugins.themes.journalMetrics.option.workflowCurrent.label"
msgstr "Позначка поточного етапу"

msgid "plugins.themes.journalMetrics.option.workflowCurrent.option"
msgstr "Позначати на лінії етапів, де перебуває рукопис: автору, що увійшов, — його власна стаття, іншим відвідувачам — остання рукопис журналу (лише етап, без назви й автора)."

msgid "plugins.themes.journalMetrics.stats.pages"
msgstr "сторінок у випуску"

