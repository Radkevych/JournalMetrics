msgstr "Day {$day} of {$total} · {$percent}%"

msgid "plugins.themes.journalMetrics.workflow.progressOver"
msgstr "Day {$day} · over the {$total}-day term"

msgid "plugins.themes.journalMetrics.workflow.progressHint"
msgstr "Typical term of the stage: {$total} days"

msgid "plugins.themes.journalMetrics.header.languageIcon"
msgstr "Language"

msgid "plugins.themes.journalMetrics.footer.developedBy"
msgstr "Developed by"

