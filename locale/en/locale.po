msgstr "Initial screening"

msgid "plugins.themes.journalMetrics.workflow.screening.term"
msgstr "up to 10 business days"

msgid "plugins.themes.journalMetrics.workflow.review"
msgstr "Peer review"

msgid "plugins.themes.journalMetrics.workflow.review.term"
msgstr "up to 90 calendar days"

msgid "plugins.themes.journalMetrics.workflow.revision"
msgstr "Revision"

msgid "plugins.themes.journalMetrics.workflow.revision.term"
msgstr "up to 30 calendar days"

msgid "plugins.themes.journalMetrics.workflow.copyediting"
msgstr "Copyediting"

msgid "plugins.themes.journalMetrics.workflow.copyediting.term"
msgstr "up to 14 business days"

msgid "plugins.themes.journalMetrics.workflow.proofreading"
msgstr "Proofreading and layout"

msgid "plugins.themes.journalMetrics.workflow.proofreading.term"
msgstr "up to 14 business days"

msgid "plugins.themes.journalMetrics.workflow.note"
msgstr "Segment widths are proportional to the number of days; business and calendar days are shown as the journal states them."

msgid "plugins.themes.journalMetrics.list.title"
msgstr "All articles in the issue"

msgid "plugins.themes.journalMetrics.list.views"
msgstr "views"

msgid "plugins.themes.journalMetrics.list.viewPdf"
msgstr "View PDF"

