msgstr "articles in the issue"

msgid "plugins.themes.journalMetrics.stats.views"
msgstr "article views"

msgid "plugins.themes.journalMetrics.stats.pdf"
msgstr "PDF views"

msgid "plugins.themes.journalMetrics.stats.source"
msgstr "Source: usage statistics of this journal, refreshed hourly."

msgid "plugins.themes.journalMetrics.workflow.eyebrow"
msgstr "Editorial workflow"

msgid "plugins.themes.journalMetrics.workflow.title"
msgstr "From submission to publication"

msgid "plugins.themes.journalMetrics.workflow.lead"
msgstr "Maximum stage durations stated by the journal."

