msgid "plugins.themes.journalMetrics.workflow.hintNone"
msgstr "You have no submissions in progress."

msgid "plugins.themes.journalMetrics.option.markerMode.label"
msgstr "Who sees the stage marker"

msgid "plugins.themes.journalMetrics.option.markerMode.description"
msgstr "Applies when the current stage marker is on. A logged-in author always sees their own submission."

msgid "plugins.themes.journalMetrics.option.markerMode.ownOrLatest"
msgstr "Author: own submission; everybody else: the journal's latest manuscript"

msgid "plugins.themes.journalMetrics.option.markerMode.ownOnly"
msgstr "Only logged-in authors, for their own submission"

msgid "plugins.themes.journalMetrics.option.mostRead.label"
msgstr "Most read articles"

msgid "plugins.themes.journalMetrics.option.mostRead.option"
msgstr "Show the three most read articles of the two latest issues on the home page."

msgid "plugins.themes.journalMetrics.option.issueArticles.label"
msgstr "Issue article list"

msgid "plugins.themes.journalMetrics.option.issueArticles.option"
msgstr "Show the full list of articles of the latest issue on the home page."

msgid "plugins.themes.journalMetrics.option.announcement.label"
msgstr "Announcement band"

msgid "plugins.themes.journalMetrics.option.announcement.option"
msgstr "Show the latest announcement as a dark band on the home page."

msgid "plugins.themes.journalMetrics.option.textSize.label"
msgstr "Text size"

msgid "plugins.themes.journalMetrics.option.textSize.option"
msgstr "Show the text size buttons in the top bar."

msgid "plugins.themes.journalMetrics.option.themeSwitch.label"
msgstr "Day and night"

msgid "plugins.themes.journalMetrics.option.themeSwitch.option"
msgstr "Show the light/dark theme buttons in the top bar."

msgid "plugins.themes.journalMetrics.option.themeMode.label"
msgstr "Default theme mode"

msgid "plugins.themes.journalMetrics.option.themeMode.description"
msgstr "Used until a visitor chooses a mode. The visitor's choice is kept in their browser."

msgid "plugins.themes.journalMetrics.option.themeMode.auto"
msgstr "Automatic: dark at night, light by day"

msgid "plugins.themes.journalMetrics.option.themeMode.day"
msgstr "Always light"

msgid "plugins.themes.journalMetrics.option.themeMode.night"
msgstr "Always dark"

msgid "plugins.themes.journalMetrics.option.nightFrom.label"
msgstr "Night starts at (hour, 0–23)"

msgid "plugins.themes.journalMetrics.option.nightFrom.description"
msgstr "For the automatic mode. Hour of the visitor's device clock."

msgid "plugins.themes.journalMetrics.option.nightTo.label"
msgstr "Night ends at (hour, 0–23)"

