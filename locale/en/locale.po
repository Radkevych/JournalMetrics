msgid "plugins.themes.journalMetrics.option.workflowCurrent.label"
msgstr "Current stage marker"

msgid "plugins.themes.journalMetrics.option.workflowCurrent.option"
msgstr "Mark the stage of a manuscript on the workflow line: a logged-in author sees their own submission, other visitors see the journal's latest manuscript (only the stage is shown, never the title or author)."

