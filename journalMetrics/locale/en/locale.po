msgid "plugins.themes.journalMetrics.name"
msgstr "Journal Metrics Theme"

msgid "plugins.themes.journalMetrics.description"
msgstr "A child theme of the default theme. Numbers-first home page with usage statistics, the editorial workflow and the full list of the latest issue; usage block on article pages; canonical links and schema.org markup for search engines."

msgid "plugins.themes.journalMetrics.option.accent.label"
msgstr "Accent colour"

msgid "plugins.themes.journalMetrics.option.accent.description"
msgstr "Colour of buttons, numbers and bars. Use a dark shade so that white text on it stays readable."

msgid "plugins.themes.journalMetrics.option.tagline.label"
msgstr "Home page tagline"

msgid "plugins.themes.journalMetrics.option.tagline.description"
msgstr "Optional second part of the home page title, printed in the accent colour after the journal name."

msgid "plugins.themes.journalMetrics.option.heroStats.label"
msgstr "Usage numbers"

msgid "plugins.themes.journalMetrics.option.heroStats.option"
msgstr "Show article, view and PDF counters of the current issue on the home page."

msgid "plugins.themes.journalMetrics.option.workflow.label"
msgstr "Editorial workflow"

msgid "plugins.themes.journalMetrics.option.workflow.option"
msgstr "Show the strip with editorial stages and their maximum durations on the home page."

